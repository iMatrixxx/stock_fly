{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndustryChain",
  "description": "产业链静态图谱契约（chains/<chain_id>.json）。P0 只做结构与 A股映射，不含买卖判断。文件名以 _ 开头的文件（如本契约）不视为链数据。",
  "type": "object",
  "required": ["chain_id", "name", "version", "updated", "nodes", "stocks", "signal_aliases"],
  "additionalProperties": true,
  "properties": {
    "chain_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "note": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "stage", "upstream", "downstream"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "stage": {"enum": ["upstream", "midstream", "downstream"]},
          "upstream": {"type": "array", "items": {"type": "string"}},
          "downstream": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "stocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node", "code", "name", "purity"],
        "properties": {
          "node": {"type": "string"},
          "code": {"type": "string", "pattern": "^\\d{6}$"},
          "name": {"type": "string", "minLength": 1},
          "purity": {"enum": ["core", "swing", "edge"], "description": "core=主营直接受益；swing=弹性；edge=间接/材料"},
          "note": {"type": "string"}
        }
      }
    },
    "signal_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "keywords"],
        "properties": {
          "node": {"type": "string"},
          "keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
